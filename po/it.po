#: extension.js:15
msgid "Topbar Icon"
msgstr "Icona della barra superiore"

#: prefs.js:14
msgid "General"
msgstr "Generale"

#: prefs.js:20
msgid "Icon"
msgstr "Icona"

#: prefs.js:21
msgid "Customize the topbar icon appearance"
msgstr "Personalizza l'aspetto dell'icona nella barra superiore"

#: prefs.js:26
msgid "Custom Icon"
msgstr "Icona personalizzata"

#: prefs.js:27
msgid "Select a custom PNG or SVG icon (leave empty for default)"
msgstr "Seleziona un'icona PNG o SVG personalizzata (lascia vuoto per quella predefinita)"

#: prefs.js:31
msgid "Choose Icon"
msgstr "Scegli icona"

#: prefs.js:38
msgid "Clear custom icon"
msgstr "Rimuovi icona personalizzata"

#: prefs.js:53
msgid "Icon Size"
msgstr "Dimensione icona"

#: prefs.js:54
msgid "Size in pixels (8-32)"
msgstr "Dimensione in pixel (8-32)"

#: prefs.js:74
msgid "Command"
msgstr "Comando"

#: prefs.js:75
msgid "Command to execute when clicking the icon"
msgstr "Comando da eseguire al clic sull'icona"

#: prefs.js:80
msgid "Custom Command"
msgstr "Comando personalizzato"

#: prefs.js:89
msgid "Clear custom command"
msgstr "Rimuovi comando personalizzato"

#: prefs.js:97
msgid "Leave empty to open the application grid by default."
msgstr "Lascia vuoto per aprire la griglia delle applicazioni."

#: prefs.js:110
msgid "Position"
msgstr "Posizione"

#: prefs.js:111
msgid "Customize the icon position in the top bar"
msgstr "Personalizza la posizione dell'icona nella barra superiore"

#: prefs.js:116
msgid "Panel Position"
msgstr "Posizione nel pannello"

#: prefs.js:117
msgid "Choose where the icon appears in the top bar"
msgstr "Scegli dove mostrare l'icona nella barra superiore"

#: prefs.js:121
msgid "Left"
msgstr "Sinistra"

#: prefs.js:122
msgid "Center"
msgstr "Centro"

#: prefs.js:123
msgid "Right"
msgstr "Destra"

#: prefs.js:142
msgid "Location"
msgstr "Ordine"

#: prefs.js:143
msgid "Adjust the icon location within the selected panel position"
msgstr "Regola l'ordine dell'icona all'interno della posizione selezionata"

#: prefs.js:162
msgid "Left Margin"
msgstr "Margine sinistro"

#: prefs.js:163
msgid "Left margin in pixels (0-50)"
msgstr "Margine sinistro in pixel (0-50)"

#: prefs.js:183
msgid "Right Margin"
msgstr "Margine destro"

#: prefs.js:184
msgid "Right margin in pixels (0-50)"
msgstr "Margine destro in pixel (0-50)"

#: prefs.js:204
msgid "Reset Preferences"
msgstr "Ripristina preferenze"

#: prefs.js:205
msgid "Clear all custom settings and restore default values"
msgstr "Cancella tutte le impostazioni personalizzate e ripristina i valori predefiniti"

#: prefs.js:223
msgid "Reset"
msgstr "Ripristina"

#: prefs.js:294
msgid "Select Icon"
msgstr "Seleziona icona"

#: prefs.js:299
msgid "Image Files"
msgstr "File immagine"
